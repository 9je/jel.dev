---
import { getCollection } from 'astro:content';
import Walk from '../layouts/Walk.astro';
import StopSection from '../components/StopSection.astro';
import FlagshipBay from '../components/FlagshipBay.astro';
import ProjectPlate from '../components/ProjectPlate.astro';
import CertWall from '../components/CertWall.astro';
import { STOPS } from '../scenes/walk/path';
import { site } from '../content/site';
import { buildTickerLines } from '../content/ticker';
import streak from '../content/streak.json';
import type { Wing } from '../content/schema';
import { STATUS_LABEL, type Status } from '../content/status';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byWing = (w: Wing) => projects.filter((p) => p.data.wing === w);
const tickerLines = buildTickerLines(projects.map((p) => ({ title: p.data.title, status: p.data.status })), streak.current);
const stop = (id: (typeof STOPS)[number]['id']) => STOPS.find((s) => s.id === id)!;
/**
 * A wing where every project carries the same status says it once, at the head of the list, and the
 * rows drop their plates. Four identical plates down the left of the Operations room read as a
 * stack of the same component rather than as four pieces of work.
 */
const sharedStatus = (list: { data: { status: Status } }[]) =>
  list.length > 1 && list.every((e) => e.data.status === list[0]!.data.status) ? list[0]!.data.status : null;
const a = site.about;

const wingStops = (['fabrication', 'recreation', 'operations'] as Wing[]).map((w) => {
  const list = byWing(w);
  const flagship = list.find((p) => p.data.flagship);
  const rest = list.filter((p) => p !== flagship);
  return { w, flagship, rest };
});

const containmentList = byWing('containment');
const containmentFlagship = containmentList.find((p) => p.data.flagship);
const containmentRest = containmentList.filter((p) => p !== containmentFlagship);
---
<Walk title="Jordan Eldridge Labs" description={site.description} tickerLines={tickerLines}>
  <StopSection id="booth" level={1} title={site.stops.booth.title} lead={site.stops.booth.lead} light={stop('booth').light}>
    <p class="intro">{site.intro}</p>
  </StopSection>

  {wingStops.map(({ w, flagship, rest }) => {
    const shared = sharedStatus([...(flagship ? [flagship] : []), ...rest]);
    return (
    <StopSection id={w} title={site.stops[w].title} lead={site.stops[w].lead} wing={w} light={stop(w).light}>
      <div data-project-list>
        {shared && <p class="list-note">Everything in this wing is {STATUS_LABEL[shared].toLowerCase()}.</p>}
        {flagship && <FlagshipBay entry={flagship} hideStatus={!!shared} />}
        {rest.map((e) => <ProjectPlate entry={e} hideStatus={!!shared} />)}
      </div>
    </StopSection>
    );
  })}

  <StopSection id="credentials" title={site.stops.credentials.title} lead={site.stops.credentials.lead} light={stop('credentials').light}>
    <div data-project-list><CertWall size="hall" /></div>
  </StopSection>

  <StopSection id="containment" title={site.stops.containment.title} lead={site.stops.containment.lead} wing="containment" light={stop('containment').light}>
    <div data-project-list>
      {containmentFlagship && <FlagshipBay entry={containmentFlagship} />}
      {containmentRest.map((e) => <ProjectPlate entry={e} />)}
    </div>
  </StopSection>

  <StopSection id="file" title={site.stops.file.title} lead={a.line} light={stop('file').light}>
    {a.body.map((p) => <p>{p}</p>)}
    <dl class="timeline">{a.timeline.map((t) => <><dt>{t.when}</dt><dd>{t.what}</dd></>)}</dl>
    <ul class="contact"><li><a href={`mailto:${a.email}`}>{a.email}</a></li><li><a href={a.github} rel="noopener">github.com/9je</a></li></ul>
    <p class="colophon">Built on Astro and Three.js. Models and textures from <a href="https://polyhaven.com" rel="noopener">Poly Haven</a> (CC0), and the GameCube controller by <a href="https://sketchfab.com/CoryRichards" rel="noopener">CoryRichards</a> (<a href="http://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>).</p>
  </StopSection>
</Walk>
