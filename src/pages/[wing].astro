---
import Base from '../layouts/Base.astro';
import { WINGS } from '../content/schema';
export function getStaticPaths() { return WINGS.map((wing) => ({ params: { wing } })); }
const target = `/#${Astro.params.wing}`;
---
<Base title="Moved" description="This section moved into the walk.">
  <meta slot="head" http-equiv="refresh" content={`0; url=${target}`} />
  <main style="padding:2rem"><p>This section moved. <a href={target}>Continue to the walk</a>.</p></main>
</Base>
