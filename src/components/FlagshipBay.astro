---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import StatusPlate from './StatusPlate.astro';
interface Props { entry: CollectionEntry<'projects'>; hideStatus?: boolean }
const { entry, hideStatus } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const sealed = d.status === 'pending-release';
---
{/* A disclosure, like every other project in the list: open it is the wing's flagship card, and
    closed it is one line of the walk's copy column, where the exhibit's card carries the copy. */}
<details class="bay" data-flagship={entry.id} data-sealed={sealed || undefined} open>
  <summary class="bay-head">
    <h3 class="bay-title">{d.title}</h3>
    {!hideStatus && <StatusPlate status={d.status} />}
  </summary>
  {/* Only a real picture earns the space. The hex panel that stood in for a missing one was an
      empty box beside every flagship on the stacked page. */}
  {d.image && !sealed && (
    <div class="bay-visual" aria-hidden="true"><Image src={d.image} alt="" width={960} height={540} loading="eager" /></div>
  )}
  <div class="bay-text">
    {sealed ? (
      <div class="bay-body">
        <p data-redacted>
          <span class="redact">Program and vendor withheld until publication.</span>
          <span class="redact">Impact class withheld until publication.</span>
        </p>
        <Content />
        {d.unlocks && <p class="bay-unlocks" data-unlocks>{d.unlocks}</p>}
      </div>
    ) : (
      <div class="bay-body">
        <p class="bay-summary">{d.summary}</p>
        <Content />
        {d.contentWarning && <p class="bay-warning" data-content-warning>{d.contentWarning}</p>}
        {d.stack.length > 0 && <p class="bay-stack">Built with {d.stack.join(', ')}.</p>}
        {d.links.length > 0 && (
          <ul class="bay-links">{d.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
        )}
      </div>
    )}
  </div>
</details>

<style>
  /* The flagship on the stacked page: no box, the same rule in the wing's colour the walk's copy
     column hangs off, and the copy at a reading measure. A picture, when there is one, sits
     beside it. */
  .bay {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 2rem;
    margin-bottom: 2.5rem;
    padding: 0.25rem 0 0.25rem 1.25rem;
    box-shadow: inset 2px 0 0 var(--wing-light);
    position: relative;
  }
  .bay:has(.bay-visual) { grid-template-columns: minmax(0, 3fr) minmax(18rem, 2fr); }
  .bay[data-sealed] { box-shadow: inset 2px 0 0 var(--hazard); }
  .bay-visual { min-height: 16rem; background: var(--bg); border-radius: var(--radius); overflow: hidden; display: grid; place-items: center; }
  .bay-visual img { width: 100%; height: 100%; object-fit: cover; }
  /* A details puts a `::details-content` box between itself and its children, which made the
     picture and the copy two blocks inside the 3fr column instead of one grid item each. This
     hands them back to the grid. Only while it is open: that box is what carries the UA's
     `content-visibility: hidden` when it is shut, and a box with `display: contents` carries
     nothing, so an unscoped rule here shows the whole card on a row that is supposed to be one
     line. Engines that do not ship the pseudo element never had the box in the first place. */
  .bay[open]::details-content { display: contents; }
  /* The summary spans the card, so the picture and the copy keep their two columns under it. */
  .bay-head { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; list-style: none; cursor: pointer; }
  .bay-head::-webkit-details-marker { display: none; }
  .bay-title { font-size: 1.6rem; }
  .bay-text { max-width: var(--measure); }
  .bay-summary { font-size: 1.1rem; }
  .bay-warning, .bay-stack, .bay-unlocks { color: var(--text-dim); font-size: 0.95rem; }
  .bay-links { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.5rem; }
  .redact {
    display: block;
    width: fit-content;
    margin-bottom: 0.4rem;
    color: transparent;
    background: #05080b;
    user-select: none;
  }
  @media (max-width: 899px) { .bay:has(.bay-visual) { grid-template-columns: 1fr; } }
</style>
