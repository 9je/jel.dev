---
import { STATUS_LABEL, type Status } from '../content/schema';
interface Props { status: Status }
const { status } = Astro.props;
---
<span class="plate condensed" data-status={status}>{STATUS_LABEL[status]}</span>

<style>
  /* A panel indicator, not a badge: a small lamp and the word, in sentence case. Lit in the wing's
     colour when it is running, an unlit ring while in flight, hazard for pending, a padlock for
     restricted, and dark for closed source. */
  .plate {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .plate::before {
    content: '';
    width: 0.5em; height: 0.5em;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    flex: none;
  }
  /* Mixed here rather than read from --wing-text, which is computed once at the root and so stays
     the lobby's cyan in every room. */
  .plate[data-status='operational'], .plate[data-status='in-flight'] { color: color-mix(in srgb, var(--wing-light) 70%, white 30%); }
  .plate[data-status='operational']::before { background: var(--wing-light); border-color: var(--wing-light); box-shadow: 0 0 6px var(--wing-light); }
  .plate[data-status='pending-release'] { color: var(--hazard); }
  .plate[data-status='pending-release']::before { background: var(--hazard); border-color: var(--hazard); }
  .plate[data-status='restricted']::before {
    width: 0.6em; height: 0.8em;
    border-radius: 1px;
    background: linear-gradient(currentColor, currentColor) 50% 30% / 60% 1.5px no-repeat;
  }
</style>
