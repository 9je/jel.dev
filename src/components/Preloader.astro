---
// The building powering up. The sign over the shutter is a dead tube in the dark, and its letters
// strike on as the rooms load, out of reading order the way a sign's tubes start. Under it, one
// line of the facility coming online. When the last letter is lit the sign stutters, and the frame
// cuts to the same sign in the room, where the camera pulls back to the booth.
const letters = [...'JEL LABS'];
// The order the tubes strike in: an index into the letters that are not the space.
const order = [2, 5, 0, 6, 3, 1, 4];
let k = 0;
const spans = letters.map((ch) => (ch === ' ' ? { ch, n: -1 } : { ch, n: order.indexOf(k++) }));
---
<div class="preloader" data-preloader data-state="loading" role="status" aria-live="polite" aria-busy="true">
  <p class="preloader-sign" data-preloader-sign aria-label="JEL Labs">
    {spans.map((s) => (s.n < 0 ? <span class="preloader-gap" aria-hidden="true"> </span> : <span class="preloader-letter" data-n={s.n} aria-hidden="true">{s.ch}</span>))}
  </p>
  <p class="preloader-label"><span data-preloader-line>Mains power</span><span class="preloader-pct"><span data-preloader-pct>0</span>%</span></p>
  <a class="preloader-lite" href="/?effects=off" data-preloader-lite hidden>Slow connection. Continue without effects</a>
</div>
