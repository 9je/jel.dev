---
import { getCollection } from 'astro:content';
interface Props { size?: 'wall' | 'hall' }
const { size = 'wall' } = Astro.props;
const certs = await getCollection('certs');
---
{/* A disclosure, like the flagship and every project row: open it is the wall of badges, and closed
    it is one line of the walk's copy column, where the room's own six plates carry it. The summary
    is hidden wherever the wall is simply there, so the stacked page reads as it always did. */}
<details class="wall" data-cert-wall data-size={size} open>
  <summary class="wall-head"><h3 id="certs-h" class="wall-title">Certifications</h3></summary>
  {/* On the walk the summary is the control and the heading is its label. On the stacked page and
      with no JS the heading is clipped to a pixel, so the grid names itself from it rather than
      standing as six badges with no group. */}
  <ul class="wall-list" aria-labelledby="certs-h">
    {certs.map(({ data: c }) => (
      <li class="badge" data-cert={c.id}>
        <img src={c.badgeImage} alt="" width="96" height="96" loading="lazy" />
        <span class="badge-name">{c.name}</span>
        <span class="badge-issuer">{c.issuer}</span>
        {c.verifyUrl && <a class="badge-verify" href={c.verifyUrl} rel="noopener">Verify</a>}
      </li>
    ))}
  </ul>
</details>

<style>
  .wall { margin-top: 3rem; }
  /* Same as the flagship bay, and scoped to the open state for the same reason: the UA's
     `::details-content` box would otherwise sit between the wall and its grid of badges, and
     giving it `display: contents` while it is shut would show the badges through a closed row. */
  .wall[open]::details-content { display: contents; }
  .wall-head { list-style: none; cursor: pointer; }
  .wall-head::-webkit-details-marker { display: none; }
  .wall-title { font-size: 1.3rem; margin-bottom: 1rem; }
  /* A register rather than a grid of badges. Six tiles of centred artwork read as a dump of what
     a badge site hands out. Ruled rows with the plate small, the name set against it and the
     issuer tracked out under it read as a record of what was earned, which is the point of the
     room. The verification link is its own control at the end of the row, where a reader looks
     for it, rather than hidden under the name. */
  .wall-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--surface-edge); }
  .badge {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1.1rem;
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--surface-edge);
  }
  .badge img { grid-row: span 2; width: 56px; height: 56px; object-fit: contain; }
  .badge-name { grid-column: 2; align-self: end; font-weight: 600; font-size: 1.02rem; }
  .badge-issuer {
    grid-column: 2; align-self: start;
    color: var(--text-dim); font-size: 0.72rem; font-stretch: 75%;
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .badge-verify {
    grid-column: 3; grid-row: span 2;
    padding: 0.2em 0.7em;
    border: 1px solid var(--surface-edge); border-radius: var(--radius);
    color: var(--text-dim); font-size: 0.78rem; font-stretch: 75%;
    letter-spacing: 0.08em; text-decoration: none;
  }
  .badge-verify:hover, .badge-verify:focus-visible { color: var(--panel-white); border-color: var(--wing-light, var(--surface-edge)); }
  .wall[data-size='hall'] .badge { padding: 1rem 0.6rem; column-gap: 1.4rem; }
  .wall[data-size='hall'] .badge img { width: 76px; height: 76px; }
  .wall[data-size='hall'] .badge-name { font-size: 1.12rem; }
  .wall[data-size='hall'] .wall-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
