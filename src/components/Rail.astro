---
import { WINGS, type Wing } from '../content/schema';
import { site } from '../content/site';
interface Props { current?: Wing | 'about' }
const { current } = Astro.props;
---
<nav class="rail" aria-label="Wayfinding">
  <a class="rail-bay condensed" href="/">Bay</a>
  <ul class="rail-list">
    {WINGS.map((w) => (
      <li>
        <a class="rail-link condensed" href={`/${w}`} aria-current={current === w ? 'page' : undefined}>{site.wings[w].name}</a>
      </li>
    ))}
  </ul>
  <a class="rail-file condensed" href="/about" aria-current={current === 'about' ? 'page' : undefined}>Personnel file</a>
</nav>

<style>
  .rail {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: var(--rail-w);
    height: 100vh;
    padding: 1.5rem 1rem;
    border-right: 1px solid var(--surface-edge);
    background: var(--bg);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    font-size: 0.85rem;
  }
  .rail a { color: var(--text-dim); text-decoration: none; }
  .rail a:hover, .rail a:focus-visible { color: var(--text); }
  .rail-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .rail-link[aria-current='page'], .rail-file[aria-current='page'] {
    color: var(--wing-text);
    padding-left: 0.6rem;
    border-left: 2px solid var(--wing-light);
    box-shadow: -2px 0 12px -4px var(--wing-light);
  }
  .rail-file { margin-top: auto; }
  @media (max-width: 899px) {
    .rail {
      position: sticky;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.25rem;
      width: auto;
      height: auto;
      padding: 0.75rem 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--surface-edge);
      z-index: 2;
    }
    .rail-list { flex-direction: row; gap: 1rem; }
    .rail-link[aria-current='page'], .rail-file[aria-current='page'] { padding-left: 0; border-left: 0; border-bottom: 2px solid var(--wing-light); box-shadow: none; }
    .rail-file { margin-top: 0; margin-left: auto; }
  }
</style>
